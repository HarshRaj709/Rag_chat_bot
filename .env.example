QDRANT_URL=your-qdrant-URL
QDRANT_API_KEY=Your-qdrant-api-key
OPENROUTER_API_KEY=Your-Openrouter-key
DATABASE_URL=your-database-url
BASE_URL=Openrouter-base-url
REDIS_URL=Redis-URL
SECRET_KEY=django-insecure-replace-me-with-actual-secret-key
DEBUG=True
EMAIL_HOST_USER="Email"
EMAIL_HOST_PASSWORD="Eamil App Password"
DEFAULT_FROM_EMAIL="Eamil"

FRONTEND_URL=http://localhost:3000
# Google OAuth client ID (Web application) for Sign-In with Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True in tests to run tasks inline without a worker
CELERY_TASK_ALWAYS_EAGER=False
# Supabase Storage bucket for KB documents (replaces local MEDIA_ROOT).
# SUPABASE_URL must be https://<project-ref>.supabase.co (NOT the DB pooler host).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=kb-documents